<?xml version="1.0" encoding="utf-8"?>
<!--
    Network Security Configuration for ExamPrep OS.

    Policy: HTTPS only in production. Cleartext traffic is disabled.
    All data at rest lives in Room (offline-first). No backend in v1.0.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Allow cleartext only in debug builds for local dev convenience -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
